# Unified web app — scanner + DTB validation (no Discord)

Copy this file to `.env` and fill values as needed.

# Finnhub (optional — scanner/news integrations)
FINNHUB_API_KEY=

# Supabase (optional — DTB-style watchlist / persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# Optional: fallback data providers when yfinance fails (quant fetch_single)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
