# Discord bot token from https://discord.com/developers/applications
# Copy this file to .env and fill in your token
# IMPORTANT: If your token was ever committed to git, rotate it in the Discord Developer Portal
DISCORD_BOT_TOKEN=your_token_here

# Supabase (optional, for watchlist). Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# Optional: fallback data providers when yfinance fails (fetch_single only)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
